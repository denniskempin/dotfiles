{
  "auto_update": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "vim_mode": true,
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 13,
  "theme": {
    "mode": "system",
    "dark": "Ayu Dark",
    "light": "Ayu Light"
  },
  "preferred_line_length": 100,
  "wrap_guides": [80, 100],
  "lsp": {
    "rust-analyzer": {
      "initialization_options": {
        "cargo": {
          "buildScripts": {
            "enable": false
          }
        },
        "procMacro": {
          "enable": false
        }
      }
    }
  }
}
