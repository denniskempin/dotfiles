# Ghostty config. Reload with Cmd+Shift+, ; opacity needs a full restart.
# Reference: https://ghostty.org/docs/config/reference

# Updates go through Homebrew (scripts/upgrade-apps.sh), not Sparkle.
auto-update = off

font-family = MonaspiceNe NFM
font-size = 12

background-opacity = 0.76
background-blur = 26

# Points, not pixels. New terminals only; open a new tab to see it.
window-padding-x = 16
window-padding-y = 16

cursor-style = bar
cursor-style-blink = false

# fish binds Alt+J and Alt+K, which Hammerspoon posts for Back and Forward.
macos-option-as-alt = true

# Hammerspoon posts these for Send to slot. Ghostty has no default for move_tab.
keybind = super+shift+arrow_left=move_tab:-1
keybind = super+shift+arrow_right=move_tab:1
